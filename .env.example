# Public Supabase connection settings (use your own project's values).
# Add these same two variables to Vercel, then redeploy.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional: show password-only login on a new device for a fixed account.
# Otherwise each device remembers the email after its first successful sign-in.
VITE_BUSINESS_LOGIN_EMAIL=
