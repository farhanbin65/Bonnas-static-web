{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/blog",
      "destination": "/api/blog"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/article"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/:page(menu|gallery|invoice|records)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/api/not-found"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "bonnas.co.uk"
        }
      ],
      "destination": "https://www.bonnas.co.uk/:path*",
      "permanent": true
    },
    {
      "source": "/blog/savoring-the-flavors-of-bengal-in-the-heart-of-london",
      "destination": "/blog/bringing-a-taste-of-bengal-to-your-table-authentic-bangladeshi-catering-in-londo",
      "permanent": true
    }
  ],
  "functions": {
    "api/blog.js": {
      "includeFiles": "{dist/index.html,dist-ssr/**}"
    },
    "api/article.js": {
      "includeFiles": "dist/index.html"
    }
  },
  "headers": [
    {
      "source": "/invoice/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/records/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
